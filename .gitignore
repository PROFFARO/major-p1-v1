# ==============================================================================
# eBPF Security Observability & Threat Detection Engine - .gitignore
# ==============================================================================

# ── Secrets & Environment Configuration ──
.env
.env.local
.env.*.local
*.pem
*.key

# ── eBPF & C Build Artifacts ──
bpf/probes/*.o
*.bpf.o
*.o
*.a
*.so
*.dylib
*.dll

bin/*

# ── Go Binaries & Build Artifacts ──
agent/ebpf-ml-agent
agent/agent
agent/bin/
*.exe

# ── Python Bytecode & Cache Files ──
__pycache__/
*.py[codz]
*$py.class
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.cache
.mypy_cache/
.ruff_cache/

# ── Virtual Environments ──
.venv/
ml_engine/.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# ── Database, Storage & Generated Telemetry ──
*.db
*.sqlite
*.sqlite3
*.sqlite3-journal
*.wal
*.shm
*.duckdb
*.duckdb.wal

# ── Runtime Logs & Audit Streams ──
logs/*
!logs/.gitkeep
*.log
audit_log.jsonl

# ── Machine Learning Models & Datasets ──
ml_engine/data/*
!ml_engine/data/.gitkeep
ml_engine/models/*.pkl
ml_engine/models/*.joblib
ml_engine/models/*.h5
ml_engine/models/*.onnx
ml_engine/models/*.pt
ml_engine/models/*.pth
ml_engine/eval_results/*
ml_engine/data_external/adfa_ld/
resources/*

# ── Standalone External Raw Integrations ──
# (Native C headers & Go decoders are embedded directly in bpf/ and agent/)
integrations/

# ── IDE, OS & Editor Temp Files ──
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
tempCodeRunnerFile.py
scratch/
