# ─────────────────────────────────────────────────────────────
# eBPF-ML Security Engine — Universal Environment Configuration
# ─────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────
# Universal LLM Copilot Settings (Supports Any Provider / Model)
# ─────────────────────────────────────────────────────────────
# Provider options: auto, gemini, openai, ollama, groq, deepseek, openrouter, custom
LLM_PROVIDER=auto

# API Key (Works with Gemini, OpenAI, Groq, DeepSeek, OpenRouter, etc.)
LLM_API_KEY=your_api_key_here

# Model Name
# Examples: gemini-2.5-flash | gpt-4o | llama3:8b | deepseek-chat | qwen2.5:7b
LLM_MODEL_NAME=gemini-2.5-flash

# Base URL (Optional — leave blank for official Gemini / OpenAI endpoints)
# Examples:
#   Local Ollama:        http://localhost:11434/v1
#   Local LM Studio:     http://localhost:1234/v1
#   Local vLLM:          http://localhost:8000/v1
#   Groq Cloud:          https://api.groq.com/openai/v1
#   DeepSeek API:        https://api.deepseek.com/v1
#   OpenRouter:          https://openrouter.ai/api/v1
#   Custom Proxy:        http://your-custom-llm-proxy.com/v1
LLM_BASE_URL=

# ─────────────────────────────────────────────────────────────
# Go Agent Connectivity Settings
# ─────────────────────────────────────────────────────────────
AGENT_WS_URL=ws://localhost:8900/ws
AGENT_REST_BASE=http://localhost:8900

# ─────────────────────────────────────────────────────────────
# ML Engine REST Server Port
# ─────────────────────────────────────────────────────────────
ML_ENGINE_HOST=0.0.0.0
ML_ENGINE_PORT=8901
